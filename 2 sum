
class Solution {
    public List<Integer> twoSum(int arr[], int target) {
        // Your code here
        List<Integer> res = new ArrayList<>();
        Set<Integer> s = new HashSet<>();
        for (int i = 0; i < arr.length; i++) {
            if (s.contains(target - arr[i])) {
                res.add(target - arr[i]);
                res.add(arr[i]);
                return res;
            }
            s.add(arr[i]);
        }
        return res;
    }
}
