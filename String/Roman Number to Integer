class Solution {
    // Finds decimal value of a given Roman numeral
    public int romanToDecimal(String s) {
        // Create a map for Roman numeral values
        HashMap<Character, Integer> map = new HashMap<>();
        map.put('I', 1);
        map.put('V', 5);
        map.put('X', 10);
        map.put('L', 50);
        map.put('C', 100);
        map.put('D', 500);
        map.put('M', 1000);

        int res = 0; // Final result

        for (int i = 0; i < s.length(); i++) {
            int curr = map.get(s.charAt(i)); // Current symbol value

            // If the next symbol exists and is greater than current (like IV = 4)
            if (i + 1 < s.length() && map.get(s.charAt(i + 1)) > curr) {
                res = res - curr;
            } else {
                res = res + curr;
            }
        }

        return res;
    }
}

