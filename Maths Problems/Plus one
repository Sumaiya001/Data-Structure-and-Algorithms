class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;
        
        // Traverse from the last digit
        for (int i = n - 1; i >= 0; i--) {
            // If the current digit is less than 9, simply add 1
            if (digits[i] < 9) {
                digits[i]++;
                return digits; // Return early as no further carry is needed
            }
            // If the digit is 9, set it to 0 and continue to the next digit
            digits[i] = 0;
        }
        
        // If all digits were 9, we need an extra digit at the front
        int[] result = new int[n + 1];
        result[0] = 1; // Set the first digit to 1, rest are 0 by default
        return result;
    }
}
