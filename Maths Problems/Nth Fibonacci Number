class Solution {
    public int nthFibonacci(int n) {
        // Base cases
        if (n <= 1) return n;

        // Recursive call
        return nthFibonacci(n - 1) + nthFibonacci(n - 2);
    }
}
  tc : 0(2n)




public int nthFibonacci(int n) {
    if (n <= 1) return n;

    int a = 0, b = 1;
    for (int i = 2; i <= n; i++) {
        int sum = a + b;
        a = b;
        b = sum;
    }
    return b;
}
tc: o(n)
