class Solution {
    static boolean armstrongNumber(int n) {
        // Store the original number
         int temp =n;
         int sum =0;
         while(temp>0){
             int digit = temp%10;
             sum += Math.pow(digit,3);
             temp /=10;
         }
              if(sum == n){
                  return true;
              }
         
         return false;
    }
}
