
class Solution {
    static List<Integer> get(int a, int b) {
        // Swap a and b without using a temporary variable
        a = a + b;
        b = a - b;
        a = a - b;

        // Return both values in a list
        List<Integer> result = new ArrayList<>();
        result.add(a);
        result.add(b);
        return result;
    }
}
