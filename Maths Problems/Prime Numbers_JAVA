class Solution {
    static boolean isPrime(int n) {
        // Corner cases: 1 is not prime, and numbers <= 0 are not prime
        if (n <= 1) {
            return false;
        }

        // Check divisors from 2 to √n
        for (int i = 2; i <= Math.sqrt(n); i++) {
            // If divisible by any number, it's not prime
            if (n % i == 0) {
                return false;
            }
        }

        // If no divisors are found, it's prime
        return true;
   
}
}
