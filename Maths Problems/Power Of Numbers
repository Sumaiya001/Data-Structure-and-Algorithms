class Solution {
    public int reverseExponentiation(int n) {
    
        int rev = 0;
        int real = n;
        while(n!=0)
        {
            int last = n%10;
            rev = rev*10+last;
            n = n/10;
        }
        int res = (int)Math.pow (real,rev);
        return res;
    }
}
