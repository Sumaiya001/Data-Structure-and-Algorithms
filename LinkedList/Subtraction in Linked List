class Solution {

    // Reverse a linked list
    static Node reverse(Node head) {
        Node prev = null;
        while (head != null) {
            Node next = head.next;
            head.next = prev;
            prev = head;
            head = next;
        }
        return prev;
    }

    // Remove leading zeros
    static Node removeLeadingZeros(Node head) {
        while (head != null && head.data == 0) {
            head = head.next;
        }
        return head == null ? new Node(0) : head;
    }

    // Compare two numbers represented as linked lists
    static int compare(Node l1, Node l2) {
        l1 = removeLeadingZeros(l1);
        l2 = removeLeadingZeros(l2);
        int len1 = 0, len2 = 0;
        for (Node temp = l1; temp != null; temp = temp.next) len1++;
        for (Node temp = l2; temp != null; temp = temp.next) len2++;
        if (len1 > len2) return 1;
        if (len1 < len2) return -1;

        while (l1 != null && l2 != null) {
            if (l1.data != l2.data)
                return l1.data > l2.data ? 1 : -1;
            l1 = l1.next;
            l2 = l2.next;
        }
        return 0;
    }

    // Actual subtract logic (assumes first >= second)
    static Node subtract(Node l1, Node l2) {
        l1 = reverse(l1);
        l2 = reverse(l2);

        Node dummy = new Node(-1);
        Node curr = dummy;
        int borrow = 0;

        while (l1 != null) {
            int d1 = l1.data;
            int d2 = l2 != null ? l2.data : 0;

            int sub = d1 - d2 - borrow;
            if (sub < 0) {
                sub += 10;
                borrow = 1;
            } else {
                borrow = 0;
            }

            curr.next = new Node(sub);
            curr = curr.next;

            l1 = l1.next;
            if (l2 != null) l2 = l2.next;
        }

        return removeLeadingZeros(reverse(dummy.next));
    }

    // Wrapper function: supports subtraction and returns result Node
    public static Node subLinkedList(Node l1, Node l2) {
        int cmp = compare(l1, l2);
        if (cmp == 0) return new Node(0);
        if (cmp > 0)
            return subtract(l1, l2);
        else
            return subtract(l2, l1); // ignore sign for now (GFG version doesn't require negative)
    }
}
