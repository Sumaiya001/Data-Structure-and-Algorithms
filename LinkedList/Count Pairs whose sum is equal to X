class Solution {
    // Function to count pairs in two linked lists whose sum is equal to x
    public int countPairs(Node head1, Node head2, int x) {
        HashSet<Integer> set = new HashSet<>();
        int count = 0;

        // Add all elements of first list to set
        Node temp1 = head1;
        while (temp1 != null) {
            set.add(temp1.data);
            temp1 = temp1.next;
        }

        // Traverse second list and check for complement (x - data)
        Node temp2 = head2;
        while (temp2 != null) {
            if (set.contains(x - temp2.data)) {
                count++;
            }
            temp2 = temp2.next;
        }

        return count;
    }
}
