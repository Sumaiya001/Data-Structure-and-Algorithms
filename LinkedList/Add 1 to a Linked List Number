class Solution {
    // Function to add 1 to the number represented by the linked list
    static Node addOne(Node head) {
        // Step 1: Reverse the linked list
        head = reverse(head);

        // Step 2: Add 1 to the number
        Node curr = head;
        int carry = 1;

        while (curr != null) {
            int sum = curr.data + carry;
            curr.data = sum % 10;
            carry = sum / 10;

            if (carry == 0) break;

            if (curr.next == null && carry != 0) {
                curr.next = new Node(0);  // extend list if needed
            }
            curr = curr.next;
        }

        // Step 3: Reverse again to restore original order
        head = reverse(head);
        return head;
    }

    // Reverse the linked list
    static Node reverse(Node head) {
        Node prev = null;
        Node curr = head;

        while (curr != null) {
            Node next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }

        return prev;
    }
}

