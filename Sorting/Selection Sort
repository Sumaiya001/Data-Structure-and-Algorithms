class Solution {
    void selectionSort(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n; i++) {

            int minidx = i;
            for (int j = i + 1; j < n; j++) {
                // FIXED: Removed the semicolon
                if (arr[j] < arr[minidx]) {
                    minidx = j;
                }
            }

            // Swap the found minimum element with the current element
            int temp = arr[minidx];
            arr[minidx] = arr[i];
            arr[i] = temp;
        }
    }
}
