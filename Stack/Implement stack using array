class MyStack {
    private int[] arr;
    private int top;

    // Constructor to initialize the stack
    public MyStack() {
        arr = new int[1000]; // Create an array of size 1000
        top = -1;            // Initially stack is empty, so top = -1
    }

    // Push an element onto the stack
    public void push(int x) {
        if (top >= 999) {
           
            return;
        }
        arr[++top] = x; // Increment top and assign value
    }

    // Pop the top element from the stack and return it
    public int pop() {
        if (top == -1) {
           
            return -1; // Or throw exception
        }
        return arr[top--]; // Return top value and decrement top
    }
}












