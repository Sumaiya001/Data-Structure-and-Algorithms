import java.util.*;

class Solution {
    public static int getMaxArea(int[] arr) {
        Stack<Integer> stack = new Stack<>();
        int maxArea = 0;
        int n = arr.length;

        for (int i = 0; i <= n; i++) {
            // Use 0 as height for the imaginary bar at end
            int height = (i == n) ? 0 : arr[i];

            // If the current bar is smaller than the bar on top of the stack

            while (!stack.isEmpty() && height < arr[stack.peek()]) {
                int top = stack.pop(); // Index of the bar

                int width = stack.isEmpty() ? i : i - stack.peek() - 1;
                int area = arr[top] * width;
                maxArea = Math.max(maxArea, area);
            }

            // Push current index to stack
            stack.push(i);
        }

        return maxArea;
    }
}
