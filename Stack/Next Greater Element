class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
        int n = arr.length;
        Stack<Integer> stack = new Stack<>(); // Holds future big elements
        ArrayList<Integer> result = new ArrayList<>(Collections.nCopies(n, -1)); // Fill all with -1 first

        // Go from right to left
        for (int i = n - 1; i >= 0; i--) {
            // Remove small or same elements - they can't help
            while (!stack.isEmpty() && stack.peek() <= arr[i]) {
                stack.pop();
            }

            // If stack is not empty, the top is the next bigger
            if (!stack.isEmpty()) {
                result.set(i, stack.peek());
            }

            // Put current number on the stack
            stack.push(arr[i]);
        }

        return result;
    }
}
