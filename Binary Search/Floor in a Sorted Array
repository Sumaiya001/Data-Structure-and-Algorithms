class Solution {

    static int findFloor(int[] arr, int x) {
        // write code here
       
        int low = 0, high = arr.length - 1;
        int floorIndex = -1;
        
        while (low <= high) {
            int mid = low + (high - low) / 2;
            
            if (arr[mid] <= x) {
                floorIndex = mid;
                low = mid + 1; // Search in the right half
            } else {
                high = mid - 1; // Search in the left half
            }
        }
        return floorIndex;
    }
}


