
class Solution {
    int maxSubarraySum(int[] arr) {
        int n = arr.length;
        int sum = 0;
        int max = Integer.MIN_VALUE; // Handles negative numbers properly

        for (int i = 0; i < n; i++) {
            sum += arr[i];

            // Update max whenever we find a new maximum subarray sum
            if (sum > max) {
                max = sum;
            }

            // If sum becomes negative, reset it to 0
            if (sum < 0) {
                sum = 0;
            }
        }

        return max;
    }
}
