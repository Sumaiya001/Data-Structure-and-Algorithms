class Solution {
    public int peakElement(int[] arr) {
        int n = arr.length;
        
        // Handle corner cases
        if (n == 1) return 0;
        if (arr[0] >= arr[1]) return 0;
        if (arr[n - 1] >= arr[n - 2]) return n - 1;

        // Check for peak in the middle
        for (int i = 1; i < n - 1; i++) {
            if (arr[i] >= arr[i - 1] && arr[i] >= arr[i + 1]) {
                return i;
            }
        }

        // Fallback (though logically shouldn't be needed)
        return -1;
    }
}
