class Solution {
    public int maxWater(int arr[]) {
        int n = arr.length;
        if (n == 0) return 0; // Edge case: Empty array
        
        int left[] = new int[n];  // Stores max height from the left
        int right[] = new int[n]; // Stores max height from the right
        
        // Fill left max array
        left[0] = arr[0];
        for (int i = 1; i < n; i++) {
            left[i] = Math.max(left[i - 1], arr[i]);
        }

        // Fill right max array
        right[n - 1] = arr[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            right[i] = Math.max(right[i + 1], arr[i]);
        }

        // Calculate trapped water
        int ans = 0;
        for (int i = 0; i < n; i++) {
            ans += Math.min(left[i], right[i]) - arr[i]; 
        }

        return ans;
    }

    }
