class Solution {
    public boolean twoSum(int arr[], int target) {
        HashSet<Integer> set = new HashSet<>();
        
        for (int num : arr) {
            int complement = target - num;
            if (set.contains(complement)) {
                return true; // Pair found
            }
            set.add(num);
        }
        return false; // No pair found
    }

}
 tc:o(n)
 sc:o(n)
